{
  "name": "status",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.pagina.json",
    "build:pagina": "esbuild src/pagina/principal.ts --bundle --format=iife --target=es2022 --minify --outfile=public/pagina.js",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.pagina.json && npm run lint && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.12",
    "@cloudflare/workers-types": "5.20261101.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "4.156.1"
  }
}
