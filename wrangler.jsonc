{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status",
  "main": "src/worker/index.ts",
  // La del workerd que trae @cloudflare/vitest-plugin: no puede ser posterior (ADR-0010).
  "compatibility_date": "2026-11-01",
  // Una sola puerta pública: el Custom Domain status.nicolasdalessandro.dev, creado a mano (ADR-0017).
  "workers_dev": false,
  // La página: archivos estáticos que no pasan por el Worker (ADR-0012). Lo que no es un archivo de
  // public/, como /api/status, va al Worker, que le devuelve a ASSETS lo que no es suyo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El loop del hub, y nada más, pasa primero por el Worker, que contesta Range: los archivos
    // estáticos no lo hacen, y Safari no reproduce un video sin un 206 (ADR-0019).
    "run_worker_first": ["/vista.mp4"]
  },
  // El código de la página se empaqueta antes de `wrangler dev` y de `wrangler deploy` (ADR-0012).
  "build": {
    "command": "npm run build:pagina"
  },
  // Una corrida por minuto prueba cada URL pública (ADR-0002).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "status",
      "database_id": "eceb51e2-ba6c-4c37-9c85-24fae19dad11",
      "migrations_dir": "migrations"
    }
  ]
}
