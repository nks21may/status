{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status",
  "main": "src/worker/index.ts",
  // La del workerd que trae @cloudflare/vitest-plugin: no puede ser posterior (ADR-0010).
  "compatibility_date": "2026-11-01",
  // Una corrida por minuto prueba cada URL pública (ADR-0002).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "status",
      // El esquema es el de ADR-0009, en migraciones de Wrangler.
      "migrations_dir": "migrations"
    }
  ]
}
